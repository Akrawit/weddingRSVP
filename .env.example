# Configure only on the server. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Supabase publishable (or legacy anon) API key; used only for admin sign-in.
SUPABASE_PUBLISHABLE_KEY=
# UUID of your confirmed Supabase Auth user. Other accounts cannot access admin.
ADMIN_USER_ID=
SITE_URL=http://localhost:3000
